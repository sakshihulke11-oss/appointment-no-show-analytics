# ============================================================
# Healthcare Appointment No-Show Analysis (R port)
# Direct translation of appointments.py (duplicate blocks removed)
# Dataset: Kaggle - Medical Appointment No Shows, 111,000+ appointments
# https://www.kaggle.com/datasets/joniarroba/noshowappointments
# ============================================================

library(dplyr)
library(ggplot2)
library(lubridate)

df <- read.csv("appointments_data.csv", stringsAsFactors = FALSE)
cat("Shape:", dim(df), "\n")
head(df)
names(df)

# removing negative age rows - data entry error
cat("negative age rows:", sum(df$age < 0), "\n")
df <- df %>% filter(age >= 0)

# 1 = no show, 0 = showed up
# NOTE: this assumes no_show is already coded 0/1 in your source CSV.
# The raw Kaggle file uses "Yes"/"No" strings in a "No-show" column --
# if you ever feed the raw file in directly, recode first:
#   df$no_show_flag <- if_else(df$No.show == "Yes", 1, 0)
unique(df$no_show)
df$no_show_flag <- df$no_show

df$scheduled_day <- as_datetime(df$scheduled_day)
df$appointment_day <- as_datetime(df$appointment_day)

total <- nrow(df)
no_shows <- sum(df$no_show_flag)
rate <- round(no_shows / total * 100, 2)
cat("Total Appointments:", total, "\n")
cat("No Shows :", no_shows, "\n")
cat("No Show Rate :", rate, "%\n")

# ------------------------------------------------
# Waiting Days Analysis
# ------------------------------------------------
df$waiting_days <- as.numeric(difftime(df$appointment_day, df$scheduled_day, units = "days"))
df <- df %>% filter(waiting_days >= 0)
cat("\nAverage Waiting Days:", round(mean(df$waiting_days), 2), "\n")

# NOTE: cut() here is open-left/closed-right, same as your Python pd.cut().
# Your SQL file uses "between 1 and 7" style bucketing instead, which puts
# an exact 1-day wait in a different bucket than this does. Pick one
# convention and use it in both places if you want the numbers to match.
df$wait_group <- cut(
  df$waiting_days,
  breaks = c(0, 1, 7, 15, 30, 60, 200),
  labels = c("Same Day", "1-7 days", "8-15 days", "16-30 days", "31-60 days", "60+ days")
)

wait_summary <- df %>%
  group_by(wait_group) %>%
  summarise(total = n(), no_shows = sum(no_show_flag)) %>%
  mutate(no_show_rate_pct = round(no_shows / total * 100, 2))

cat("\nNo Show Rate by Waiting Days:\n")
print(wait_summary)

# ------------------------------------------------
# Age Group Analysis
# ------------------------------------------------
df$age_group <- cut(
  df$age,
  breaks = c(0, 12, 17, 30, 45, 60, 100),
  labels = c("Child", "Teen", "Young Adult", "Adult", "Middle Age", "Senior")
)

age_summary <- df %>%
  group_by(age_group) %>%
  summarise(total = n(), no_shows = sum(no_show_flag)) %>%
  mutate(no_show_rate_pct = round(no_shows / total * 100, 2)) %>%
  arrange(desc(no_show_rate_pct))

cat("\nNo Show Rate by Age Group:\n")
print(age_summary)

# ------------------------------------------------
# Gender Analysis
# ------------------------------------------------
gender_summary <- df %>%
  group_by(gender) %>%
  summarise(total = n(), no_shows = sum(no_show_flag)) %>%
  mutate(no_show_rate_pct = round(no_shows / total * 100, 2))

cat("\nNo Show Rate by Gender:\n")
print(gender_summary)

# ------------------------------------------------
# SMS Reminder Effectiveness
# ------------------------------------------------
sms_summary <- df %>%
  group_by(sms_received) %>%
  summarise(total = n(), no_shows = sum(no_show_flag)) %>%
  mutate(no_show_rate_pct = round(no_shows / total * 100, 2))
sms_summary$sms_received <- c("No SMS", "SMS Sent")[sms_summary$sms_received + 1]

cat("\nSMS Reminder Impact:\n")
print(sms_summary)

# ------------------------------------------------
# Chronic Conditions Analysis
# ------------------------------------------------
for (condition in c("hypertension", "diabetes", "alcoholism")) {
  condition_rate <- round(mean(df$no_show_flag[df[[condition]] == 1]) * 100, 2)
  cat(condition, "patients no show rate:", condition_rate, "%\n")
}

# ------------------------------------------------
# Neighborhood Analysis (100+ appointments only)
# ------------------------------------------------
nb_summary <- df %>%
  group_by(neighborhood) %>%
  summarise(total = n(), no_shows = sum(no_show_flag)) %>%
  filter(total >= 100) %>%
  mutate(no_show_rate_pct = round(no_shows / total * 100, 2)) %>%
  arrange(desc(no_show_rate_pct))

cat("\nTop 10 Neighborhoods by No Show Rate:\n")
print(head(nb_summary, 10))

# ------------------------------------------------
# Visualizations
# ------------------------------------------------
p1 <- ggplot(age_summary, aes(x = reorder(age_group, no_show_rate_pct), y = no_show_rate_pct)) +
  geom_col(fill = "tomato") +
  coord_flip() +
  labs(x = NULL, y = "No Show Rate (%)", title = "No Show Rate by Age Group") +
  theme_minimal()
ggsave("noshow_by_age.png", p1, width = 10, height = 5)
print(p1)

p2 <- ggplot(wait_summary, aes(x = wait_group, y = no_show_rate_pct)) +
  geom_col(fill = "steelblue") +
  labs(x = NULL, y = "No Show Rate (%)", title = "No Show Rate by Waiting Days") +
  theme(axis.text.x = element_text(angle = 20, hjust = 1))
ggsave("noshow_by_waiting.png", p2, width = 9, height = 5)
print(p2)

p3 <- ggplot(sms_summary, aes(x = sms_received, y = no_show_rate_pct, fill = sms_received)) +
  geom_col() +
  scale_fill_manual(values = c("steelblue", "coral")) +
  labs(x = NULL, y = "No Show Rate (%)", title = "SMS Reminder Impact on No Show Rate") +
  theme(legend.position = "none")
ggsave("noshow_sms_impact.png", p3, width = 6, height = 4)
print(p3)

cat("\ndone\n")
