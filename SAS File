/* ============================================================
   Healthcare Appointment No-Show Analysis (SAS port)
   Direct translation of appointments.py + "Medical appointments sql"
   Dataset: Kaggle - Medical Appointment No Shows, 111,000+ appointments
   https://www.kaggle.com/datasets/joniarroba/noshowappointments
   ============================================================ */

/* 1. Import */
proc import datafile="/data/appointments_data.csv"
    out=appts
    dbms=csv
    replace;
    getnames=yes;
run;

/* 2. Data quality checks (mirrors the SQL file's diagnostic queries) */
proc sql;
    select count(*) as negative_age_rows from appts where age < 0;
    select count(*) as invalid_dates from appts where appointment_day < scheduled_day;
quit;

/* 3. Clean: remove negative age rows */
data appts_clean;
    set appts;
    where age >= 0;
    /* 1 = no show, 0 = showed up.
       NOTE: assumes no_show is already coded 0/1 in the source file --
       the raw Kaggle file uses "Yes"/"No" text in a "No-show" column.
       If you ever load the raw file directly, recode first:
       no_show_flag = (no_show = "Yes"); */
    no_show_flag = no_show;
    format scheduled_day appointment_day date9.;
run;

/* 4. Overall No-Show Rate */
proc sql;
    select count(*) as total_appointments,
           sum(no_show_flag) as no_shows,
           count(*) - sum(no_show_flag) as showed_up,
           round(100.0*sum(no_show_flag)/count(*), 0.01) as no_show_rate_pct
    from appts_clean;
quit;

/* 5. Waiting Days Analysis
   NOTE: bucket edges here follow "between" logic (matches your SQL file),
   which is NOT the same as pd.cut()'s open-left/closed-right bins in your
   Python script -- an exact 1-day wait lands in a different bucket
   depending on which of your three tools (Python/SQL/SAS) you check.
   Standardize this if you want the numbers to match across the project. */
data appts_final;
    set appts_clean;
    waiting_days = appointment_day - scheduled_day;
    where waiting_days >= 0;
    length wait_group $10;
    if waiting_days = 0 then wait_group = "Same Day";
    else if waiting_days <= 7 then wait_group = "1-7 days";
    else if waiting_days <= 15 then wait_group = "8-15 days";
    else if waiting_days <= 30 then wait_group = "16-30 days";
    else if waiting_days <= 60 then wait_group = "31-60 days";
    else wait_group = "60+ days";
run;

proc means data=appts_final mean;
    var waiting_days;
run;

proc sql;
    create table wait_summary as
    select wait_group,
           count(*) as total,
           sum(no_show_flag) as no_shows,
           round(100.0*sum(no_show_flag)/count(*), 0.01) as no_show_rate_pct
    from appts_final
    group by wait_group
    order by no_show_rate_pct desc;
quit;

/* 6. Age Group Analysis */
data appts_final;
    set appts_final;
    length age_group $12;
    if age <= 12 then age_group = "Child";
    else if age <= 17 then age_group = "Teen";
    else if age <= 30 then age_group = "Young Adult";
    else if age <= 45 then age_group = "Adult";
    else if age <= 60 then age_group = "Middle Age";
    else age_group = "Senior";
run;

proc sql;
    create table age_summary as
    select age_group,
           count(*) as total,
           sum(no_show_flag) as no_shows,
           round(100.0*sum(no_show_flag)/count(*), 0.01) as no_show_rate_pct
    from appts_final
    group by age_group
    order by no_show_rate_pct desc;
quit;

/* 7. Gender Analysis */
proc sql;
    create table gender_summary as
    select gender,
           count(*) as total,
           sum(no_show_flag) as no_shows,
           round(100.0*sum(no_show_flag)/count(*), 0.01) as no_show_rate_pct
    from appts_final
    group by gender;
quit;

/* 8. SMS Reminder Effectiveness */
proc sql;
    create table sms_summary as
    select case sms_received when 1 then "SMS Sent" else "No SMS" end as sms_status,
           count(*) as total,
           sum(no_show_flag) as no_shows,
           round(100.0*sum(no_show_flag)/count(*), 0.01) as no_show_rate_pct
    from appts_final
    group by sms_received;
quit;

/* 9. Chronic Conditions Analysis */
proc sql;
    create table chronic_summary as
    select "Hypertension" as condition_name, count(*) as total,
           sum(no_show_flag) as no_shows,
           round(100.0*sum(no_show_flag)/count(*), 0.01) as no_show_rate_pct
    from appts_final where hypertension = 1
    outer union corr
    select "Diabetes", count(*), sum(no_show_flag),
           round(100.0*sum(no_show_flag)/count(*), 0.01)
    from appts_final where diabetes = 1
    outer union corr
    select "Alcoholism", count(*), sum(no_show_flag),
           round(100.0*sum(no_show_flag)/count(*), 0.01)
    from appts_final where alcoholism = 1;
quit;

/* 10. Neighborhood Analysis - 100+ appointments only, ranked (window function) */
proc sql;
    create table nb_summary as
    select neighborhood,
           count(*) as total_appointments,
           sum(no_show_flag) as no_shows,
           round(100.0*sum(no_show_flag)/count(*), 0.01) as no_show_rate_pct
    from appts_final
    group by neighborhood
    having count(*) >= 100;
quit;

proc sql;
    create table nb_ranked as
    select neighborhood, total_appointments, no_shows, no_show_rate_pct,
           rank() over (order by no_show_rate_pct desc) as rank_by_noshow
    from nb_summary
    order by rank_by_noshow;
quit;

/* 11. Day of Week Analysis */
data appts_final;
    set appts_final;
    day_name = put(weekday(appointment_day), downame.);
run;

proc sql;
    create table dow_summary as
    select day_name,
           count(*) as total,
           sum(no_show_flag) as no_shows,
           round(100.0*sum(no_show_flag)/count(*), 0.01) as no_show_rate_pct
    from appts_final
    group by day_name;
quit;

/* 12. High-Risk Segment: no SMS + long wait + no chronic condition */
proc sql;
    select count(*) as high_risk_total,
           sum(no_show_flag) as actually_missed,
           round(100.0*sum(no_show_flag)/count(*), 0.01) as no_show_rate_pct
    from appts_final
    where sms_received = 0
      and waiting_days > 15
      and hypertension = 0
      and diabetes = 0;
quit;
